    "title": "\u06f1\u06f0 \u062f\u0627\u0646\u0633\u062a\u0646\u06cc \u0634\u06af\u0641\u062a\u200c\u0627\u0646\u06af\u06cc\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u062f\u0627\u0631\u0648\u0633\u0627\u0632\u0627\u0646 \u0645\u0634\u0647\u0648\u0631 \u06a9\u0647 \u062a\u0627\u0631\u06cc\u062e \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0627\u062f\u0646\u062f",
    "description": "\u062f\u0646\u06cc\u0627\u06cc \u0645\u062f\u0631\u0646 \u06a9\u0646\u0648\u0646\u06cc \u060c \u0645\u062f\u06cc\u0648\u0646 \u062a\u0644\u0627\u0634\u200c\u0647\u0627\u06cc \u0628\u06cc \u0648\u0642\u0641\u0647 \u0627\u0641\u0631\u0627\u062f\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u0622\u0632\u0645\u0627\u06cc\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u06a9\u0648\u0686\u06a9 \u0648 \u062f\u0627\u0631\u0648\u062e\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc\u060c \u062a\u0631\u06a9\u06cc\u0628\u0627\u062a\u06cc \u062c\u0627\u062f\u0648\u06cc\u06cc \u062e\u0644\u0642 \u06a9\u0631\u062f\u0646\u062f. \u062f\u0627\u0631\u0648\u0633\u0627\u0632\u0627\u0646 \u0645\u0634\u0647\u0648\u0631\u060c \u062a\u0646\u0647\u0627 \u0641\u0631\u0648\u0634\u0646\u062f\u06af\u0627\u0646 \u062f\u0627\u0631\u0648 \u0646\u0628\u0648\u062f\u0646\u062f\u061b \u0622\u0646\u200c\u0647\u0627 \u062f\u0627\u0646\u0634\u0645\u0646\u062f\u0627\u0646\u06cc \u062c\u0633\u0648\u0631\u060c \u0645\u062e\u062a\u0631\u0639\u0627\u0646\u06cc \u0646\u0648\u0622\u0648\u0631 \u0648 \u06af\u0627\u0647\u06cc \u062a\u0627\u062c\u0631\u0627\u0646\u06cc \u0632\u06cc\u0631\u06a9 \u0628\u0648\u062f\u0646\u062f \u06a9\u0647 \u0628\u0627 \u06a9\u0634\u0641\u06cc\u0627\u062a \u062e\u0648\u062f \u0627\u0632 \u0645\u0631\u06af\u2026",
